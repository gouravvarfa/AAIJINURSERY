# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed - .env.example only documents which keys exist.

# Random secret used to sign login session cookies. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value in production than in local development.
SESSION_SECRET_KEY=

# Outgoing email (order confirmations, password reset links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Razorpay (test mode keys while developing) - secret key must NEVER be
# exposed to the frontend
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: WhatsApp order alerts to the admin via CallMeBot
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Centralized customer-facing WhatsApp messaging (Communications module) via
# AiSensy. Never hardcode these - backend-only, never exposed to the
# frontend. Leave AISENSY_API_KEY blank to run with messaging fully wired
# but not actually sending (every send fails cleanly as CONFIGURATION_ERROR).
AISENSY_API_KEY=
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_TIMEOUT=15
AISENSY_RETRY_COUNT=3

# Optional: switch the active WhatsApp provider to Meta's own Cloud API
# directly (e.g. for instant testing via a Meta test number, while an
# AiSensy WABA verification is still pending). Leave unset/"aisensy" for
# normal operation.
WHATSAPP_PROVIDER=aisensy
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_ID=
WHATSAPP_CLOUD_API_VERSION=v20.0

# AI customer assistant (app/ai/) -- all three are FREE-TIER keys, none
# required for the site to run; with none set, /api/ai/chat replies with a
# graceful "AI not available" message instead of erroring. Tried in order:
# Groq (primary) -> Gemini (fallback) -> OpenRouter (optional third).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Default developer-role admin account, auto-created only when the
# admin_users table is empty (e.g. Render free tier's SQLite resets on
# every deploy). Falls back to admin/aaiji@admin123 if unset - set these
# in production so a public default credential isn't recreated.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
